{
  "name": "dailoop",
  "version": "0.1.7",
  "license": "MIT",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "web": "node scripts/preview.mjs",
    "preview": "node scripts/serve-export.mjs",
    "verify": "node scripts/verify.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "test:stress": "tsx --test tests/stress.test.ts",
    "test:decoder": "tsx --test tests/decoder.test.ts",
    "typecheck": "tsc --noEmit",
    "test:domain": "tsx --test tests/domain.test.ts",
    "test:storage": "tsx --test tests/schema.test.ts tests/session.test.ts tests/native-boundary.test.ts",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "check:expo": "expo install --check",
    "lint": "eslint src app tests",
    "postinstall": "node scripts/patch-android-blur.mjs && node scripts/patch-android-audio.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.4.1",
    "@expo/metro-runtime": "57.0.16",
    "@formatjs/intl-datetimeformat": "7.8.1",
    "@formatjs/intl-getcanonicallocales": "3.2.12",
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-numberformat": "9.4.3",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@formatjs/intl-segmenter": "12.2.15",
    "date-fns": "4.4.0",
    "expo": "57.0.28",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-blur": "57.0.3",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.4",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "57.0.2",
    "expo-linking": "57.0.12",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.26",
    "expo-sharing": "57.0.23",
    "expo-splash-screen": "57.0.10",
    "expo-sqlite": "57.0.4",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "safe-uri-decoder": "npm:decode-uri-component@0.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "test-renderer": "1.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
